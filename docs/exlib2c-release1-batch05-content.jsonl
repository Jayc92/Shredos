{"proposed_canonical_name": "Kettlebell clean and press", "aliases": [], "primary_muscle": "full_body", "muscle_targets": [{"muscle": "front_delts", "role": "secondary"}, {"muscle": "glutes", "role": "secondary"}, {"muscle": "abs", "role": "tertiary"}], "equipment": "kettlebell", "tracking_mode": "weight_reps", "laterality": "unilateral", "movement_pattern": "vertical_push", "training_role": "conditioning", "difficulty": "advanced", "availability": "home_gym", "provenance": "forgefitos_original", "authored_by": "ForgeFitOS content program (AI-drafted original prose; pending human specialist review)", "authored_at": "2026-08-28", "setup_steps": ["Stand over a kettlebell with feet hip-width and hinge to grip its handle with one hand.", "Keep the free arm out for balance and clear space around you on all sides.", "Start with a light bell and learn the clean and the press fresh, before any fatigue sets in."], "execution_steps": ["Hike the bell back between the legs, then drive the hips to swing it up close to the body.", "Guide the bell around the wrist to land softly in the rack position at the shoulder \u2014 no thud on the forearm.", "Press that arm to a straight, stacked finish overhead, then lower back to the rack with control.", "Return the bell between the legs to start the next rep.", "Complete the set on one side, then switch hands and match the load and reps."], "breathing_cue": "Exhale as the bell reaches the rack and again as the press finishes overhead; inhale as it lowers each time.", "common_mistakes": ["Letting the bell flip and bang the forearm at the rack.", "Pressing before the rack position is settled and stable.", "Curling the bell up with the arm instead of driving with the hips."], "safety_guidance": "Own each position before the next: settle the rack before pressing and control the lower before re-hiking; if a press stalls or the bell drifts, lower it to the rack, then set the bell down and pause \u2014 never try to catch or steer a bell that has