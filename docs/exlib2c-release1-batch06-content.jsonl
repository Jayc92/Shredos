ns."], "safety_guidance": "This lift compounds fatigue quickly, so end the set while the rack position, squat balance, and overhead control are all still crisp; squat only as deep as you can stay balanced \u2014 depth is individual here. If the bar drifts overhead or the elbows will not stay up, lower the bar to the rack position and walk it back to the hooks \u2014 never drop or throw the bar down from overhead.", "equipment_setup": "Take the bar from rack hooks rather than cleaning it from the floor; check the overhead clearance where you stand, re-test the hook height with an unloaded bar after any rack change, and keep the collars secured.", "substitutions": [], "regressions": ["Front squat", "Overhead press"], "progressions": [], "accessibility_alternative": "As a regression, practice the parts separately with light weight \u2014 a goblet squat for the squat half and a light single-dumbbell press for the press half \u2014 before combining them under one bar.", "content_review": {"status": "pending", "reviewer": null, "reviewed_at": null, "rationale": null}, "review_status": "proposed", "import_eligible": false, "deferred": false, "deferred_reason": null}
